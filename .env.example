# MtaaBiz environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.

# Core Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_BASE_URL=http://localhost:8000
DJANGO_TIME_ZONE=Africa/Nairobi
DJANGO_LOG_LEVEL=INFO
DJANGO_ADMINS=Collins:you@example.com

# Database (Postgres in production, e.g. postgres://user:pass@host:5432/mtaabiz)
# Leave unset to use the local SQLite file.
DATABASE_URL=

# Cache (Redis in production, e.g. redis://localhost:6379/0)
REDIS_URL=

# Email (EMAIL_BACKEND=smtp enables real sending; console otherwise)
EMAIL_BACKEND=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MtaaBiz <no-reply@mtaabiz.co.ke>

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Error monitoring (optional, https://sentry.io)
SENTRY_DSN=

# Security
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
